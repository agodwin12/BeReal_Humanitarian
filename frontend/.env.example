# Public website — copy to .env.local

# The Express API. Leave empty to run the site in demo mode (forms validated but not sent).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match PREVIEW_SECRET on the API: lets the backoffice "Preview" button open unpublished content.
PREVIEW_SECRET=change-me

# Only for a production-mode run on one machine where the API is on localhost:
# lets the image optimizer fetch photos from a private IP. Never set this on a server.
ALLOW_LOCAL_IMAGE_HOST=false
