# Backoffice — copy to .env.local

# The Express API. Leave empty for demo mode (any credentials sign in as a demo Super Admin).
NEXT_PUBLIC_API_URL=http://localhost:4000

# The public website (View site links, page previews, built-in copy for the Pages editor).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same value as PREVIEW_SECRET on the API and the website.
NEXT_PUBLIC_PREVIEW_SECRET=change-me

# Shown in the header badge: test | live
NEXT_PUBLIC_STRIPE_MODE=test
