NODE_ENV=development
PORT=4000

# Browsers allowed to call the API (comma-separated): public site + backoffice
CLIENT_URLS=http://localhost:3000,http://localhost:3001
SITE_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:3001

# PostgreSQL — either a single URL (e.g. Neon) or the individual fields
# DATABASE_URL=postgres://user:password@host:5432/be_real_humanitarian
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=be_real_humanitarian
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# First Super Admin (used once by `npm run seed:admin`)
SEED_ADMIN_NAME=Desmond Nkemzi
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Resend (transactional email). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=Be Real Humanitarian Works <no-reply@berealhumanitarian.org>
EMAIL_NOTIFY_TO=

# Cloudflare R2 (media, Phase C)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=be-real-humanitarian-media
R2_PUBLIC_URL=

# Cloudflare Turnstile (form anti-spam, Phase B)
TURNSTILE_SECRET_KEY=

# Phase C content
API_PUBLIC_URL=http://localhost:4000

# Daily backup (npm run backup / cron on the server): content JSON + PostgreSQL dump + media archive
BACKUP_DIR=
BACKUP_STATUS_PATH=
BACKUP_KEEP_DAYS=14
PREVIEW_SECRET=
CONTENT_SEED_DIR=

# Donations (Phase E)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
